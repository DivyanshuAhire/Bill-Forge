  "layout": {
    "page": {
      "size": "A4",
      "orientation": "portrait",
      "margin_top_mm": 10,
      "margin_bottom_mm": 10,
      "margin_left_mm": 10,
      "margin_right_mm": 10
    },
    "fonts": {
      "primary_family": "Arial, sans-serif",
      "header_size_pt": 13,
      "body_size_pt": 9,
      "small_size_pt": 8,
      "label_weight": "bold",
      "value_weight": "normal"
    },
    "colors": {
      "border": "#000000",
      "header_bg": "#ffffff",
      "row_bg": "#ffffff",
      "text_primary": "#000000",
      "text_secondary": "#333333"
    },
    "sections": [
      {
        "id": "header_bar",
        "type": "full_width_centered_text",
        "content_key": "invoice.meta.title",
        "style": {
          "font_weight": "bold",
          "font_size_pt": 14,
          "text_align": "center",
          "border_bottom": true,
          "padding_bottom_mm": 2
        }
      },
      {
        "id": "top_info_row",
        "type": "two_column_split",
        "border": true,
        "left": {
          "width_percent": 55,
          "content": "seller_block",
          "includes_logo": true,
          "logo_position": "left_of_text",
          "fields": [
            {
              "key": "seller.company_name",
              "style": "bold_large"
            },
            {
              "key": "seller.address_lines",
              "style": "normal",
              "multiline": true
            },
            {
              "key": "seller.gstin_uin",
              "label": "GSTIN/UIN:",
              "style": "normal"
            },
            {
              "key": "seller.state_name",
              "label": "State Name :",
              "append": "Code : {seller.state_code}",
              "style": "normal"
            },
            {
              "key": "seller.email",
              "label": "E-Mail :",
              "style": "normal"
            }
          ]
        },
        "right": {
          "width_percent": 45,
          "content": "meta_grid",
          "rows": [
            {
              "cols": [
                {
                  "label": "Invoice No.",
                  "value_key": "invoice.meta.invoice_no",
                  "style": "bold"
                },
                {
                  "label": "Dated",
                  "value_key": "invoice.meta.dated",
                  "style": "bold"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Delivery Note",
                  "value_key": "invoice.meta.delivery_note"
                },
                {
                  "label": "Mode/Terms of Payment",
                  "value_key": "invoice.meta.mode_terms_of_payment"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Reference No. & Date.",
                  "value_key": "invoice.meta.reference_no_and_date",
                  "colspan": 1
                },
                {
                  "label": "Other References",
                  "value_key": "invoice.meta.other_references"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Buyer's Order No.",
                  "value_key": "invoice.meta.buyers_order_no"
                },
                {
                  "label": "Dated",
                  "value_key": "invoice.meta.buyers_order_dated"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Dispatch Doc No.",
                  "value_key": "invoice.meta.dispatch_doc_no"
                },
                {
                  "label": "Delivery Note Date",
                  "value_key": "invoice.meta.delivery_note_date"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Dispatched through",
                  "value_key": "invoice.meta.dispatched_through"
                },
                {
                  "label": "Destination",
                  "value_key": "invoice.meta.destination"
                }
              ]
            },
            {
              "cols": [
                {
                  "label": "Terms of Delivery",
                  "value_key": "invoice.meta.terms_of_delivery",
                  "colspan": 2
                }
              ]
            }
          ]
        }
      },
      {
        "id": "consignee_buyer_row",
        "type": "two_column_split",
        "border": true,
        "left": {
          "width_percent": 50,
          "content": "consignee_block",
          "label": "Consignee (Ship to)",
          "fields": [
            {
              "key": "consignee.company_name",
              "style": "bold"
            },
            {
              "key": "consignee.gstin_uin",
              "label": "GSTIN/UIN :",
              "style": "normal"
            },
            {
              "key": "consignee.state_name",
              "label": "State Name :",
              "append": "Code : {consignee.state_code}"
            }
          ]
        },
        "right": {
          "width_percent": 50,
          "content": "buyer_block",
          "label": "Buyer (Bill to)",
          "fields": [
            {
              "key": "buyer.company_name",
              "style": "bold"
            },
            {
              "key": "buyer.gstin_uin",
              "label": "GSTIN/UIN :",
              "style": "normal"
            },
            {
              "key": "buyer.state_name",
              "label": "State Name :",
              "append": "Code : {buyer.state_code}"
            }
          ]
        }
      },
      {
        "id": "line_items_table",
        "type": "table",
        "border": true,
        "header_row": {
          "bg_color": "#f0f0f0",
          "columns": [
            {
              "id": "description",
              "label": "Description of Goods",
              "width_percent": 35,
              "align": "left"
            },
            {
              "id": "hsn_sac",
              "label": "HSN/SAC",
              "width_percent": 12,
              "align": "center"
            },
            {
              "id": "quantity",
              "label": "Quantity",
              "width_percent": 13,
              "align": "center"
            },
            {
              "id": "rate",
              "label": "Rate",
              "width_percent": 12,
              "align": "right"
            },
            {
              "id": "per",
              "label": "per",
              "width_percent": 8,
              "align": "center"
            },
            {
              "id": "amount",
              "label": "Amount",
              "width_percent": 20,
              "align": "right"
            }
          ]
        },
        "body_rows": {
          "source": "invoice.line_items",
          "min_empty_rows": 10,
          "row_height_mm": 7,
          "cell_padding_mm": 2
        },
        "sub_rows_after_items": [
          {
            "type": "tax_row",
            "source": "invoice.taxes",
            "columns": [
              {
                "col_id": "description",
                "value_template": "{label}",
                "align": "right",
                "style": "italic_bold",
                "colspan": 4
              },
              {
                "col_id": "rate",
                "value_key": "rate_percent",
                "suffix": " %",
                "align": "right",
                "style": "italic_bold"
              },
              {
                "col_id": "amount",
                "value_key": "amount",
                "align": "right",
                "style": "italic_bold",
                "format": "indian_currency_no_symbol"
              }
            ]
          },
          {
            "type": "round_off_row",
            "columns": [
              {
                "col_id": "description",
                "value": "Round Off",
                "align": "right",
                "style": "italic_bold",
                "colspan": 5
              },
              {
                "col_id": "amount",
                "value_key": "totals.round_off",
                "align": "right",
                "style": "italic_bold"
              }
            ]
          }
        ],
        "footer_row": {
          "label": "Total",
          "label_align": "right",
          "quantity_col": {
            "col_id": "quantity",
            "value_key": "totals.total_quantity",
            "suffix": " {totals.total_quantity_unit}"
          },
          "amount_col": {
            "col_id": "amount",
            "value_key": "totals.grand_total",
            "format": "indian_currency_with_symbol",
            "style": "bold"
          }
        }
      },
      {
        "id": "amount_in_words_row",
        "type": "full_width_text",
        "border": true,
        "label": "Amount Chargeable (in words)",
        "label_style": "normal",
        "value_key": "invoice.totals.amount_in_words",
        "value_style": "bold"
      },
      {
        "id": "bottom_row",
        "type": "two_column_split",
        "border": true,
        "left": {
          "width_percent": 55,
          "rows": [
            {
              "id": "declaration_block",
              "label": "Declaration",
              "label_style": "normal_small",
              "value_key": "invoice.footer.declaration",
              "value_style": "normal_small"
            }
          ]
        },
        "right": {
          "width_percent": 45,
          "rows": [
            {
              "id": "bank_details_block",
              "label": "Company's Bank Details",
              "label_style": "bold_small",
              "fields": [
                {
                  "label": "Bank Name  :",
                  "value_key": "invoice.bank_details.bank_name",
                  "style": "normal"
                },
                {
                  "label": "A/c No.       :",
                  "value_key": "invoice.bank_details.account_no",
                  "style": "normal"
                },
                {
                  "label": "Branch & IFS Code :",
                  "value_template": "{invoice.bank_details.branch} & {invoice.bank_details.ifsc_code}",
                  "style": "normal"
                }
              ]
            },
            {
              "id": "signatory_block",
              "align": "right",
              "fields": [
                {
                  "value_key": "invoice.footer.signatory_label",
                  "style": "bold"
                },
                {
                  "value_key": "invoice.footer.signatory_title",
                  "style": "normal mt-40"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "jurisdiction_note",
        "type": "full_width_centered_text",
        "value_key": "invoice.footer.jurisdiction_note",
        "style": "normal",
        "border_top": true
      },
      {
        "id": "computer_generated_note",
        "type": "full_width_centered_text",
        "value_key": "invoice.footer.computer_generated_note",
        "style": "normal_small"
      }
    ]
  },
  "formatting_rules": {
    "currency": {
      "locale": "en-IN",
      "symbol": "₹",
      "decimal_places": 2,
      "use_indian_numbering_system": true
    },
    "date_format": "DD-MMM-YY",
    "quantity_decimal_places": 2,
    "rate_decimal_places": 2,
    "amount_decimal_places": 2,
    "amount_in_words_language": "en-IN",
    "amount_in_words_currency": "INR"
  }
}